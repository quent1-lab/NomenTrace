# Nomentrace : sauvegarde nocturne hors du serveur, copiée par installer.sh dans
# /etc/nomentrace/sauvegarde.env (lisible par root seul : systemd la lit et passe les
# valeurs au seul service de sauvegarde, jamais à l'application).

# Demande pré-authentifiée d'écriture sur le bucket Object Storage, terminée par /o/ :
# https://objectstorage.REGION.oraclecloud.com/p/JETON/n/ESPACE/b/BUCKET/o/
NOMENTRACE_SAUVEGARDE_URL=

# Clés publiques age (une par ligne) : seules les clés privées correspondantes, gardées
# hors du serveur, pourront relire les sauvegardes.
NOMENTRACE_SAUVEGARDE_CLES=/etc/nomentrace/cles_sauvegarde.txt
