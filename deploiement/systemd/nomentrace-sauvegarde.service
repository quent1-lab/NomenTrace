[Unit]
Description=Nomentrace, sauvegarde chiffrée hors du serveur
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=nomentrace
Group=nomentrace
WorkingDirectory=/opt/nomentrace
EnvironmentFile=/etc/nomentrace/nomentrace.env
EnvironmentFile=/etc/nomentrace/sauvegarde.env
ExecStart=/bin/bash /opt/nomentrace/deploiement/sauvegarde_distante.sh
Nice=10
IOSchedulingClass=idle

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/nomentrace
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
