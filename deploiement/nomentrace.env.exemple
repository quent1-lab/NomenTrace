# Nomentrace : réglages de l'instance, copiés par installer.sh dans
# /etc/nomentrace/nomentrace.env. Lus par le service, les scripts et commande.sh.
# Aucun secret ici : le fichier est lisible par l'utilisateur nomentrace.

# Adresse publique : sert aux liens d'invitation affichés en ligne de commande.
NOMENTRACE_URL=https://__DOMAINE__

# Code stable du projet servi, auquel les rôles des comptes sont rattachés.
NOMENTRACE_PROJET=principal

# Écoute : la boucle locale seulement, Caddy est seul exposé.
NOMENTRACE_HOTE=127.0.0.1
NOMENTRACE_PORT=__PORT__
# Connexions simultanées au-delà desquelles Uvicorn répond 503.
NOMENTRACE_CONCURRENCE=100

# Données, hors du dossier de l'application.
NOMENTRACE_BASE=/var/lib/nomentrace/data/nomentrace.db
NOMENTRACE_COMPTES=/var/lib/nomentrace/data/comptes.db
NOMENTRACE_ECHANGE=/var/lib/nomentrace/echange

# Le code appartient à root : Python ne tente pas d'y écrire son cache.
PYTHONDONTWRITEBYTECODE=1
